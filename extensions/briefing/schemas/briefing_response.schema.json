{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "today_tasks": {
      "type": "array",
      "items": { "type": "string" },
      "maxItems": 3
    },
    "notes": {
      "type": "array",
      "items": { "type": "string" },
      "maxItems": 2
    }
  },
  "required": ["today_tasks", "notes"]
}
