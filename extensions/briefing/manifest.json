{
  "id": "briefing",
  "version": "0.1.0",
  "type": "content-provider",
  "official": true,
  "aps_api": "1",
  "entrypoint": "entrypoint.py",
  "resources": [
    "briefing_core.py",
    "schemas/briefing_response.schema.json"
  ],
  "capabilities": [
    "daily_briefing",
    "project_briefing",
    "service_maintenance"
  ],
  "operations": [
    "briefing.daily",
    "briefing.project",
    "service.maintenance_due"
  ],
  "schedules": [
    {
      "schedule_id": "briefing.daily-refresh",
      "cron": "0 6 * * *",
      "timezone": "Asia/Seoul",
      "enabled": true,
      "request": {
        "operation": "briefing.daily",
        "input": {},
        "context": {}
      }
    },
    {
      "schedule_id": "briefing.service-maintenance",
      "cron": "15 5 * * *",
      "timezone": "Asia/Seoul",
      "enabled": true,
      "request": {
        "operation": "service.maintenance_due",
        "input": {},
        "context": {}
      }
    }
  ],
  "agent_tasks": [
    {
      "task_id": "briefing.project-analyze",
      "mode": "workflow",
      "contract_module": "contracts.py",
      "contract_model": "BriefingAIResponse",
      "prompt_file": "prompts/project-analyze.md",
      "allowed_tools": [],
      "tool_capabilities": [],
      "max_steps": 1,
      "max_input_chars": 200000,
      "max_output_chars": 10000,
      "timeout_seconds": 600
    }
  ],
  "vault_access": "read-only",
  "network": "ai-provider-only",
  "activation": "restart"
}
