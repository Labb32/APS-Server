APS_OPERATOR_TOKEN=replace-with-a-long-random-token
APS_VIEWER_TOKEN=replace-with-a-different-long-random-token
APS_SCHEDULER_TOKEN=replace-with-a-third-long-random-token
# 다른 env 파일을 사용할 경우 host/Compose interpolation에서 지정
# APS_ENV_FILE=/srv/aps/aps-server.env

# local: named volume에 새 Vault 생성, git: 원격 clone, mounted: 기존 Git Vault mount
APS_VAULT_MODE=local
APS_VAULT_GIT_URL=
APS_VAULT_GIT_BRANCH=
APS_VAULT_MOUNT=aps-vault

# 쉼표로 구분한 image 내 공식 확장 ID. 예: briefing
APS_INITIAL_EXTENSIONS=

# 선택형 aps-index 컨테이너 주소. 미설정 시 Core lexical 검색만 사용
# APS_INDEX_URL=http://aps-index:8090

# mount한 KEY=VALUE 설정 파일을 사용할 때 지정
# APS_CONFIG_FILE=/config/aps.env
APS_CONFIG_MOUNT=./deploy/config

# host bind Vault 예시: APS_VAULT_MOUNT=/srv/aps/repo
# host Codex 인증 bind 예시: APS_CODEX_HOME_MOUNT=/srv/aps/codex-home
APS_CODEX_HOME_MOUNT=aps-codex-home

APS_BIND_HOST=127.0.0.1
APS_BIND_PORT=8080
APS_HTTP_PORT=8080
APS_SYNC_BEFORE_JOB=true
APS_JOB_WORKERS=2
APS_JOB_QUEUE_SIZE=100
APS_JOB_TIMEOUT_SECONDS=900
APS_SCHEDULER_ENABLED=true
APS_SCHEDULER_TIMEZONE=Asia/Seoul
APS_SCHEDULER_POLL_SECONDS=30
APS_SCHEDULER_MISFIRE_LOOKBACK_MINUTES=1440
