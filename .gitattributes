# Keep container and configuration inputs portable across Windows and Linux.
* text=auto

*.py text eol=lf
*.sh text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.html text eol=lf
*.css text eol=lf
*.svg text eol=lf
Dockerfile text eol=lf
.env.example text eol=lf
deploy/config/*.example text eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
