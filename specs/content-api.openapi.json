{
  "openapi": "3.1.0",
  "info": {
    "title": "APS Server Content API",
    "version": "0.1.0",
    "description": "Single-owner APS content API. Content GET endpoints return pre-generated JSON or fixed-template HTML and never invoke Codex during the request."
  },
  "servers": [{"url": "/"}],
  "security": [{"bearerAuth": []}],
  "paths": {
    "/v1/content/briefing/daily": {
      "get": {
        "operationId": "getDailyBriefing",
        "summary": "Get the latest daily briefing",
        "parameters": [{"$ref": "#/components/parameters/Format"}],
        "responses": {
          "200": {
            "description": "Latest validated daily briefing",
            "content": {
              "application/json": {"schema": {"$ref": "#/components/schemas/DailyBriefingResponse"}},
              "text/html": {"schema": {"type": "string"}}
            }
          },
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "403": {"$ref": "#/components/responses/Forbidden"},
          "404": {"$ref": "#/components/responses/ContentNotGenerated"}
        }
      }
    },
    "/v1/content/projects": {
      "get": {
        "operationId": "getProjectCatalog",
        "summary": "Get the project catalog",
        "parameters": [{"$ref": "#/components/parameters/Format"}],
        "responses": {
          "200": {
            "description": "Latest validated project catalog",
            "content": {
              "application/json": {"schema": {"$ref": "#/components/schemas/ProjectCatalogResponse"}},
              "text/html": {"schema": {"type": "string"}}
            }
          },
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "403": {"$ref": "#/components/responses/Forbidden"},
          "404": {"$ref": "#/components/responses/ContentNotGenerated"}
        }
      }
    },
    "/v1/content/projects/{project_id}/briefing": {
      "get": {
        "operationId": "getProjectBriefing",
        "summary": "Get one project's latest briefing",
        "parameters": [
          {"$ref": "#/components/parameters/ProjectId"},
          {"$ref": "#/components/parameters/Format"}
        ],
        "responses": {
          "200": {
            "description": "Latest validated project briefing",
            "content": {
              "application/json": {"schema": {"$ref": "#/components/schemas/ProjectBriefingResponse"}},
              "text/html": {"schema": {"type": "string"}}
            }
          },
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "403": {"$ref": "#/components/responses/Forbidden"},
          "404": {"$ref": "#/components/responses/NotFound"}
        }
      }
    },
    "/v1/content/services/maintenance": {
      "get": {
        "operationId": "getServiceMaintenance",
        "summary": "Get active service maintenance status",
        "parameters": [
          {"$ref": "#/components/parameters/Format"},
          {"$ref": "#/components/parameters/MaintenanceScope"}
        ],
        "responses": {
          "200": {
            "description": "Latest validated service maintenance content",
            "content": {
              "application/json": {"schema": {"$ref": "#/components/schemas/ServiceMaintenanceResponse"}},
              "text/html": {"schema": {"type": "string"}}
            }
          },
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "403": {"$ref": "#/components/responses/Forbidden"},
          "404": {"$ref": "#/components/responses/ContentNotGenerated"}
        }
      }
    },
    "/v1/content/ideas": {
      "get": {
        "operationId": "getIdeas",
        "summary": "Get staged and organized ideas",
        "parameters": [
          {"$ref": "#/components/parameters/Format"},
          {"$ref": "#/components/parameters/IdeaStatus"},
          {"name": "cluster_id", "in": "query", "required": false, "schema": {"type": "string", "maxLength": 80}}
        ],
        "responses": {
          "200": {
            "description": "Latest validated idea content",
            "content": {
              "application/json": {"schema": {"$ref": "#/components/schemas/IdeasResponse"}},
              "text/html": {"schema": {"type": "string"}}
            }
          },
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "403": {"$ref": "#/components/responses/Forbidden"},
          "404": {"$ref": "#/components/responses/ContentNotGenerated"}
        }
      }
    },
    "/v1/ideas": {
      "post": {
        "operationId": "createIdea",
        "summary": "Stage an idea without invoking Codex",
        "requestBody": {
          "required": true,
          "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CreateIdeaRequest"}}}
        },
        "responses": {
          "201": {
            "description": "Idea received in staging",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CreateIdeaResponse"}}}
          },
          "400": {"$ref": "#/components/responses/BadRequest"},
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "403": {"$ref": "#/components/responses/Forbidden"},
          "429": {"$ref": "#/components/responses/RateLimited"}
        }
      }
    },
    "/v1/project-requests": {
      "post": {
        "operationId": "createProjectRequest",
        "summary": "Create a project proposal request without invoking Codex",
        "requestBody": {
          "required": true,
          "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CreateProjectRequest"}}}
        },
        "responses": {
          "201": {
            "description": "Project request awaiting confirmation",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ProjectConfirmationRequired"}}}
          },
          "400": {"$ref": "#/components/responses/BadRequest"},
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "403": {"$ref": "#/components/responses/Forbidden"},
          "429": {"$ref": "#/components/responses/RateLimited"}
        }
      }
    },
    "/v1/project-requests/{request_id}/confirm": {
      "post": {
        "operationId": "confirmProjectRequest",
        "summary": "Confirm a project request and queue project.propose",
        "parameters": [{"$ref": "#/components/parameters/RequestId"}],
        "responses": {
          "202": {
            "description": "project.propose Job accepted",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/JobAccepted"}}}
          },
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "403": {"$ref": "#/components/responses/Forbidden"},
          "404": {"$ref": "#/components/responses/NotFound"},
          "409": {"$ref": "#/components/responses/Conflict"}
        }
      }
    },
    "/v1/content/status": {
      "get": {
        "operationId": "getContentStatus",
        "summary": "Get materialized content freshness and availability",
        "responses": {
          "200": {
            "description": "Content generation status",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ContentStatusResponse"}}}
          },
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "403": {"$ref": "#/components/responses/Forbidden"}
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {"type": "http", "scheme": "bearer", "bearerFormat": "opaque"}
    },
    "parameters": {
      "Format": {
        "name": "format",
        "in": "query",
        "required": false,
        "schema": {"type": "string", "enum": ["json", "html"], "default": "json"}
      },
      "ProjectId": {
        "name": "project_id",
        "in": "path",
        "required": true,
        "schema": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"}
      },
      "RequestId": {
        "name": "request_id",
        "in": "path",
        "required": true,
        "schema": {"type": "string", "pattern": "^project_request_[A-Z0-9]+$"}
      },
      "MaintenanceScope": {
        "name": "scope",
        "in": "query",
        "required": false,
        "schema": {"type": "string", "enum": ["due", "overdue", "upcoming", "all"], "default": "due"}
      },
      "IdeaStatus": {
        "name": "status",
        "in": "query",
        "required": false,
        "schema": {"type": "string", "enum": ["received", "organized", "proposed", "published", "all"], "default": "all"}
      }
    },
    "schemas": {
      "ContentMetadata": {
        "type": "object",
        "required": ["schema_version", "content_type", "generated_at", "vault_commit", "generator_version", "stale", "partial_failure", "sha256", "data"],
        "properties": {
          "schema_version": {"type": "string", "const": "1.0"},
          "content_type": {"type": "string"},
          "generated_at": {"type": "string", "format": "date-time"},
          "vault_commit": {"type": "string", "pattern": "^[0-9a-f]{7,64}$"},
          "generator_version": {"type": "string", "minLength": 1, "maxLength": 64},
          "stale": {"type": "boolean"},
          "partial_failure": {"type": "boolean"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "data": {"type": "object"}
        }
      },
      "TaskItem": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "completion", "status"],
        "properties": {
          "task_id": {"type": ["string", "null"], "maxLength": 100},
          "title": {"type": "string", "minLength": 1, "maxLength": 300},
          "completion": {"type": "string", "minLength": 1, "maxLength": 1000},
          "status": {"type": "string", "enum": ["pending", "in_progress", "blocked", "completed"]}
        }
      },
      "Issue": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message"],
        "properties": {
          "code": {"type": "string", "pattern": "^[A-Z0-9_]+$"},
          "message": {"type": "string", "maxLength": 1000},
          "subject_id": {"type": ["string", "null"], "maxLength": 100}
        }
      },
      "ProjectBriefing": {
        "type": "object",
        "additionalProperties": false,
        "required": ["project_id", "name", "status", "summary", "tasks", "decisions", "issues"],
        "properties": {
          "project_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
          "name": {"type": "string", "minLength": 1, "maxLength": 200},
          "status": {"type": "string", "maxLength": 40},
          "tier": {"type": ["string", "null"], "maxLength": 20},
          "summary": {"type": "string", "maxLength": 2000},
          "tasks": {"type": "array", "maxItems": 20, "items": {"$ref": "#/components/schemas/TaskItem"}},
          "decisions": {"type": "array", "maxItems": 10, "items": {"type": "string", "maxLength": 1000}},
          "issues": {"type": "array", "maxItems": 20, "items": {"$ref": "#/components/schemas/Issue"}}
        }
      },
      "DailyBriefingData": {
        "type": "object",
        "additionalProperties": false,
        "required": ["as_of_date", "summary", "projects", "service_maintenance"],
        "properties": {
          "as_of_date": {"type": "string", "format": "date"},
          "summary": {
            "type": "object",
            "additionalProperties": false,
            "required": ["active_projects", "tasks", "decisions", "services_due"],
            "properties": {
              "active_projects": {"type": "integer", "minimum": 0},
              "tasks": {"type": "integer", "minimum": 0},
              "decisions": {"type": "integer", "minimum": 0},
              "services_due": {"type": "integer", "minimum": 0}
            }
          },
          "projects": {"type": "array", "items": {"$ref": "#/components/schemas/ProjectBriefing"}},
          "service_maintenance": {"type": "array", "items": {"$ref": "#/components/schemas/ServiceMaintenanceItem"}}
        }
      },
      "DailyBriefingResponse": {
        "allOf": [
          {"$ref": "#/components/schemas/ContentMetadata"},
          {"type": "object", "properties": {"content_type": {"const": "daily_briefing"}, "data": {"$ref": "#/components/schemas/DailyBriefingData"}}}
        ]
      },
      "ProjectCatalogItem": {
        "type": "object",
        "additionalProperties": false,
        "required": ["project_id", "name", "status", "briefing_available"],
        "properties": {
          "project_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
          "name": {"type": "string", "minLength": 1, "maxLength": 200},
          "status": {"type": "string", "maxLength": 40},
          "tier": {"type": ["string", "null"], "maxLength": 20},
          "briefing_available": {"type": "boolean"}
        }
      },
      "ProjectCatalogData": {
        "type": "object",
        "additionalProperties": false,
        "required": ["projects"],
        "properties": {"projects": {"type": "array", "items": {"$ref": "#/components/schemas/ProjectCatalogItem"}}}
      },
      "ProjectCatalogResponse": {
        "allOf": [
          {"$ref": "#/components/schemas/ContentMetadata"},
          {"type": "object", "properties": {"content_type": {"const": "project_catalog"}, "data": {"$ref": "#/components/schemas/ProjectCatalogData"}}}
        ]
      },
      "ProjectBriefingData": {
        "type": "object",
        "additionalProperties": false,
        "required": ["project"],
        "properties": {"project": {"$ref": "#/components/schemas/ProjectBriefing"}}
      },
      "ProjectBriefingResponse": {
        "allOf": [
          {"$ref": "#/components/schemas/ContentMetadata"},
          {"type": "object", "properties": {"content_type": {"const": "project_briefing"}, "data": {"$ref": "#/components/schemas/ProjectBriefingData"}}}
        ]
      },
      "ServiceMaintenanceItem": {
        "type": "object",
        "additionalProperties": false,
        "required": ["service_id", "name", "service_status", "due_status", "days_overdue", "issues"],
        "properties": {
          "service_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,79}$"},
          "name": {"type": "string", "minLength": 1, "maxLength": 200},
          "service_status": {"type": "string", "maxLength": 40},
          "maintenance_cycle": {"type": ["string", "null"], "maxLength": 100},
          "maintenance_interval_days": {"type": ["integer", "null"], "minimum": 1, "maximum": 3650},
          "last_maintenance": {"type": ["string", "null"], "format": "date"},
          "next_maintenance_due": {"type": ["string", "null"], "format": "date"},
          "due_status": {"type": "string", "enum": ["due", "overdue", "upcoming", "unknown"]},
          "days_overdue": {"type": "integer", "minimum": 0},
          "maintenance_summary": {"type": ["string", "null"], "maxLength": 2000},
          "issues": {"type": "array", "items": {"$ref": "#/components/schemas/Issue"}}
        }
      },
      "ServiceMaintenanceData": {
        "type": "object",
        "additionalProperties": false,
        "required": ["as_of_date", "scope", "summary", "services"],
        "properties": {
          "as_of_date": {"type": "string", "format": "date"},
          "scope": {"type": "string", "enum": ["due", "overdue", "upcoming", "all"]},
          "summary": {
            "type": "object",
            "additionalProperties": false,
            "required": ["active_services", "due", "overdue", "upcoming", "unknown"],
            "properties": {
              "active_services": {"type": "integer", "minimum": 0},
              "due": {"type": "integer", "minimum": 0},
              "overdue": {"type": "integer", "minimum": 0},
              "upcoming": {"type": "integer", "minimum": 0},
              "unknown": {"type": "integer", "minimum": 0}
            }
          },
          "services": {"type": "array", "items": {"$ref": "#/components/schemas/ServiceMaintenanceItem"}}
        }
      },
      "ServiceMaintenanceResponse": {
        "allOf": [
          {"$ref": "#/components/schemas/ContentMetadata"},
          {"type": "object", "properties": {"content_type": {"const": "service_maintenance"}, "data": {"$ref": "#/components/schemas/ServiceMaintenanceData"}}}
        ]
      },
      "IdeaItem": {
        "type": "object",
        "additionalProperties": false,
        "required": ["idea_id", "content", "tags", "status", "received_at"],
        "properties": {
          "idea_id": {"type": "string", "pattern": "^idea_[A-Z0-9]+$"},
          "content": {"type": "string", "minLength": 1, "maxLength": 8000},
          "tags": {"type": "array", "maxItems": 20, "items": {"type": "string", "maxLength": 50}},
          "status": {"type": "string", "enum": ["received", "organized", "proposed", "published"]},
          "received_at": {"type": "string", "format": "date-time"},
          "cluster_id": {"type": ["string", "null"], "maxLength": 80}
        }
      },
      "IdeaCluster": {
        "type": "object",
        "additionalProperties": false,
        "required": ["cluster_id", "canonical_idea", "member_idea_ids", "categories", "merge_status"],
        "properties": {
          "cluster_id": {"type": "string", "maxLength": 80},
          "canonical_idea": {"type": "string", "maxLength": 4000},
          "member_idea_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "categories": {"type": "array", "items": {"type": "string", "maxLength": 80}},
          "merge_status": {"type": "string", "enum": ["suggested", "approved", "rejected"]}
        }
      },
      "IdeasData": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ideas", "clusters"],
        "properties": {
          "ideas": {"type": "array", "items": {"$ref": "#/components/schemas/IdeaItem"}},
          "clusters": {"type": "array", "items": {"$ref": "#/components/schemas/IdeaCluster"}}
        }
      },
      "IdeasResponse": {
        "allOf": [
          {"$ref": "#/components/schemas/ContentMetadata"},
          {"type": "object", "properties": {"content_type": {"const": "ideas"}, "data": {"$ref": "#/components/schemas/IdeasData"}}}
        ]
      },
      "CreateIdeaRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["content"],
        "properties": {
          "content": {"type": "string", "minLength": 1, "maxLength": 8000},
          "tags": {"type": "array", "maxItems": 20, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 50}}
        }
      },
      "CreateIdeaResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["idea_id", "status", "received_at"],
        "properties": {
          "idea_id": {"type": "string", "pattern": "^idea_[A-Z0-9]+$"},
          "status": {"const": "received"},
          "received_at": {"type": "string", "format": "date-time"}
        }
      },
      "CreateProjectRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "objective"],
        "properties": {
          "title": {"type": "string", "minLength": 1, "maxLength": 200},
          "objective": {"type": "string", "minLength": 1, "maxLength": 4000},
          "source_idea_ids": {"type": "array", "maxItems": 20, "uniqueItems": true, "items": {"type": "string", "pattern": "^idea_[A-Z0-9]+$"}},
          "constraints": {"type": "array", "maxItems": 30, "items": {"type": "string", "minLength": 1, "maxLength": 1000}}
        }
      },
      "ProjectConfirmationRequired": {
        "type": "object",
        "additionalProperties": false,
        "required": ["request_id", "status", "confirmation"],
        "properties": {
          "request_id": {"type": "string", "pattern": "^project_request_[A-Z0-9]+$"},
          "status": {"const": "confirmation_required"},
          "confirmation": {
            "type": "object",
            "additionalProperties": false,
            "required": ["summary", "planned_changes", "expires_at"],
            "properties": {
              "summary": {"type": "string", "maxLength": 1000},
              "planned_changes": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"type": "string", "maxLength": 500}},
              "expires_at": {"type": "string", "format": "date-time"}
            }
          }
        }
      },
      "JobAccepted": {
        "type": "object",
        "additionalProperties": false,
        "required": ["job_id", "status", "operation", "status_url"],
        "properties": {
          "job_id": {"type": "string", "pattern": "^job_[A-Z0-9]+$"},
          "status": {"const": "queued"},
          "operation": {"const": "project.propose"},
          "status_url": {"type": "string", "pattern": "^/v1/jobs/job_[A-Z0-9]+$"}
        }
      },
      "ContentStatusItem": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "formats"],
        "properties": {
          "status": {"type": "string", "enum": ["missing", "refreshing", "ready", "failed"]},
          "formats": {"type": "array", "uniqueItems": true, "items": {"type": "string", "enum": ["json", "html"]}},
          "generated_at": {"type": ["string", "null"], "format": "date-time"},
          "stale": {"type": "boolean", "default": false},
          "succeeded": {"type": "integer", "minimum": 0},
          "failed": {"type": "integer", "minimum": 0}
        }
      },
      "ContentStatusResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["vault_commit", "generated_at", "generator_version", "stale", "content"],
        "properties": {
          "vault_commit": {"type": ["string", "null"]},
          "generated_at": {"type": ["string", "null"], "format": "date-time"},
          "generator_version": {"type": "string"},
          "stale": {"type": "boolean"},
          "content": {
            "type": "object",
            "additionalProperties": {"$ref": "#/components/schemas/ContentStatusItem"}
          }
        }
      },
      "ErrorDetail": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message", "request_id", "details"],
        "properties": {
          "code": {"type": "string", "pattern": "^[A-Z0-9_]+$"},
          "message": {"type": "string", "maxLength": 2000},
          "request_id": {"type": "string", "pattern": "^req_[A-Z0-9]+$"},
          "details": {"type": "array", "items": {"type": "object"}}
        }
      },
      "ErrorResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["error"],
        "properties": {"error": {"$ref": "#/components/schemas/ErrorDetail"}}
      }
    },
    "responses": {
      "BadRequest": {"description": "Invalid input", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorResponse"}}}},
      "Unauthorized": {"description": "Authentication required", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorResponse"}}}},
      "Forbidden": {"description": "Operation forbidden", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorResponse"}}}},
      "NotFound": {"description": "Resource not found", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorResponse"}}}},
      "ContentNotGenerated": {"description": "No validated content exists", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorResponse"}}}},
      "Conflict": {"description": "Invalid state or expired confirmation", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorResponse"}}}},
      "RateLimited": {"description": "Token rate limit exceeded", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorResponse"}}}}
    }
  }
}
