ARG APS_SERVER_BASE=aps-server:local
ARG CODEX_VERSION=0.149.1

FROM node:22-bookworm-slim AS codex-cli
ARG CODEX_VERSION
RUN npm install --global "@openai/codex@${CODEX_VERSION}"

FROM ${APS_SERVER_BASE}

LABEL org.opencontainers.image.title="APS Server with Codex" \
      org.opencontainers.image.description="APS Server optional runtime with the Codex CLI adapter"

USER root

COPY --from=codex-cli /usr/local/bin/node /usr/local/bin/node
COPY --from=codex-cli /usr/local/lib/node_modules/@openai/codex /usr/local/lib/node_modules/@openai/codex

RUN ln -s /usr/local/lib/node_modules/@openai/codex/bin/codex.js /usr/local/bin/codex \
    && mkdir -p /codex-home \
    && chown -R aps:aps /codex-home

ENV CODEX_HOME=/codex-home

USER aps
